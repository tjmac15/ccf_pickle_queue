rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // This app has no login screen by design — anyone with the link
    // (your open-play group) can check in and update the queue.
    // That means these rules are intentionally open. If you want to
    // lock it down further later, add Firebase App Check or Firebase
    // Auth and tighten these rules to require it.

    match /players/{playerId} {
      allow read, write: if true;
    }
    match /courts/{courtId} {
      allow read, write: if true;
    }
    match /matches/{matchId} {
      allow read, write: if true;
    }
    match /config/{docId} {
      allow read, write: if true;
    }
  }
}
