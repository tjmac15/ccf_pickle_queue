rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{playerId} {
      allow read, write: if true;
    }
    match /courts/{courtId} {
      allow read, write: if true;
    }
    match /matches/{matchId} {
      allow read, write: if true;
    }
    match /config/{docId} {
      allow read, write: if true;
    }
  }
}
